# ---------------------------------------------------------------------------
# Diese Datei nach .env.local kopieren und ausfüllen:  cp .env.example .env.local
#
# Alle Werte sind optional. Fehlt die Sanity-Projekt-ID, rendert die Seite
# automatisch mit Platzhalterinhalten aus lib/fallback.ts — der Build läuft
# also auch ohne jede Konfiguration durch.
# ---------------------------------------------------------------------------

# --- Sanity ----------------------------------------------------------------
# Nach "npx sanity init --env .env.local" stehen die ersten beiden Werte hier drin.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Nur für die Draft-Vorschau nötig. Token mit Leserechten unter
# sanity.io/manage -> API -> Tokens anlegen. Niemals mit NEXT_PUBLIC_ präfixen.
SANITY_API_READ_TOKEN=

# --- Kontaktformular (Resend) ----------------------------------------------
# Ohne Key nimmt /api/contact die Anfrage an und protokolliert sie serverseitig,
# statt einen Fehler zu werfen. Key unter resend.com/api-keys.
RESEND_API_KEY=

# Empfängeradresse der Formularmails.
CONTACT_TO_EMAIL=

# Absenderadresse. Bis die eigene Domain bei Resend verifiziert ist, funktioniert
# onboarding@resend.dev — damit erreichen Mails allerdings nur die eigene
# Resend-Kontoadresse.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Seite -----------------------------------------------------------------
# Für Canonical-URLs, Sitemap und OpenGraph. Ohne Wert nutzt die Seite die
# von Vercel gesetzte VERCEL_URL, lokal http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
